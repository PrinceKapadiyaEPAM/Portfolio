NODE_ENV=production

# Server
PORT=4000

# Database — Azure DB for PostgreSQL Flexible Server
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/portfolio?sslmode=require

# Redis — Azure Cache for Redis (TLS)
REDIS_ENABLED=true
REDIS_HOST=your-cache.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=YOUR_REDIS_KEY
REDIS_TLS=true
REDIS_KEY_PREFIX=nse:

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_64_BYTE_HEX_STRING
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
FRONTEND_URL=https://your-frontend-app.azurewebsites.net

# Sentry (optional — leave blank to disable)
SENTRY_DSN=https://YOUR_KEY@o0.ingest.sentry.io/PROJECT_ID
