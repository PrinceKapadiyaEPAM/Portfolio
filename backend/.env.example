# App
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# Database (Azure PostgreSQL Flexible Server)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Redis (Azure Cache for Redis)
REDIS_HOST=your-cache.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=your-redis-key
REDIS_TLS=true
REDIS_KEY_PREFIX=nse:

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# NSE Polling
NSE_POLL_ENABLED=true
NSE_WATCH_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
NSE_OPTION_SYMBOLS=NIFTY,BANKNIFTY
NSE_EQUITY_INTERVAL_MS=15000
NSE_INDEX_INTERVAL_MS=10000
NSE_OPTIONS_INTERVAL_MS=60000
NSE_GAINERS_INTERVAL_MS=30000
NSE_STATUS_INTERVAL_MS=60000
NSE_MAX_RETRIES=3
NSE_RETRY_BASE_DELAY_MS=2000
NSE_CIRCUIT_OPEN_DURATION_MS=120000
